# Publish the finished article; keep sources and previews local.
/publish/*
!/publish/bench-press-90-to-100.html

# Jekyll output and caches.
/_site/
/.jekyll-cache/
/.sass-cache/
/.jekyll-metadata

# Local Ruby dependencies; keep Gemfile and Gemfile.lock versioned if added.
/.bundle/
/vendor/bundle/
/vendor/cache/

# Local Python environments and bytecode.
/.venv/
/venv/
__pycache__/
*.py[cod]

# Environment secrets; sanitized examples may be committed.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# OS metadata and editor temporary files.
.DS_Store
._*
.AppleDouble/
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
/.idea/
